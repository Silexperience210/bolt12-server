# ============================================
# Bolt12 Server Configuration
# ============================================

# --------------------------------------------
# Server
# --------------------------------------------
PORT=3001
NODE_ENV=production

# --------------------------------------------
# API Security
# Generate: openssl rand -hex 32
# Leave empty to auto-generate on first start
# --------------------------------------------
API_KEY=

# --------------------------------------------
# LND (REST API)
# --------------------------------------------
LND_REST_HOST=host.docker.internal:8080
LND_TLS_PATH=/lnd/tls.cert
LND_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# --------------------------------------------
# LNDK (gRPC)
# LNDK forwards this macaroon to LND for auth, so it must be an LND macaroon
# (LNDK does not issue its own). TLS, however, is LNDK's own generated cert.
# --------------------------------------------
LNDK_HOST=host.docker.internal:10010
LNDK_TLS_PATH=/lndk-data/tls-cert.pem
LNDK_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# --------------------------------------------
# Lightning Address / LNURL-pay (optional)
# Requires a publicly accessible domain with HTTPS + port forwarding.
# Once set, your Lightning Address will be: pay@yourdomain.com
# Leave LNURL_DOMAIN empty to disable this feature.
# --------------------------------------------
LNURL_DOMAIN=
LNURL_USERNAME=pay
LNURL_MIN_MSATS=1000
LNURL_MAX_MSATS=10000000000
