# ============================================
# Bolt12 Offer Server Configuration
# ============================================

# --------------------------------------------
# LND Configuration
# --------------------------------------------
# Host:port of your LND node
LND_HOST=umbrel.local:10009
LND_PORT=10009

# Path to LND TLS certificate
LND_TLS_PATH=/home/umbrel/umbrel/app-data/lightning/data/lnd/tls.cert

# Path to admin macaroon (mainnet)
LND_MACAROON_PATH=/home/umbrel/umbrel/app-data/lightning/data/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# Path to lncli binary (optional, auto-detected if not set)
# LNCLI_PATH=/home/umbrel/umbrel/bin/lncli

# --------------------------------------------
# API Security
# --------------------------------------------
# Generate a strong random key: openssl rand -hex 32
API_KEY=change-me-to-a-secure-random-key-minimum-32-characters

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Port to run the server on
PORT=3000

# Node environment (development/production)
NODE_ENV=production

# --------------------------------------------
# Optional Settings
# --------------------------------------------
# Force Bolt12 type for invoices (requires LND 0.18+)
# FORCE_BOLT12=false

# Show all invoices (not just Bolt12) in list
# SHOW_ALL_INVOICES=false
